# Copy this file to .env.local and fill in the values from Supabase.
# Never put the real values on GitHub.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Flutterwave secret key (only needed for "Check with Flutterwave" on a payment)
FLUTTERWAVE_SECRET_KEY=

# Flutterwave webhook "Secret hash" (you choose it in Flutterwave > Settings > Webhooks)
FLUTTERWAVE_WEBHOOK_HASH=

# WhatsApp payment agent (Meta WhatsApp Business Platform)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
