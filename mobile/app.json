{
  "expo": {
    "name": "Ona Iwa Mimo",
    "slug": "ona-iwa-mimo",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "onaiwamimo",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.onaiwamimo.app",
      "versionCode": 4,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "permissions": [],
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "com.onaiwamimo.app",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#14228C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
